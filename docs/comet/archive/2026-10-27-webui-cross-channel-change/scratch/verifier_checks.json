{
  "kind": "dispatch-verifier",
  "checks": [
    {
      "id": "compile-webui",
      "name": "compile webui",
      "executable": ".venv/Scripts/python.exe",
      "argv": ["-m", "py_compile", "app/change_detection_webui.py"],
      "cwdRef": ".",
      "timeoutMs": 120000,
      "repeatable": true
    },
    {
      "id": "data-facts",
      "name": "verify embedding/mask/gallery facts",
      "executable": ".venv/Scripts/python.exe",
      "argv": ["docs/comet/changes/webui-cross-channel-change/scratch/verify_facts.py"],
      "cwdRef": ".",
      "timeoutMs": 300000,
      "repeatable": true
    },
    {
      "id": "independent-recompute",
      "name": "independent numpy recompute of d and residuals",
      "executable": ".venv/Scripts/python.exe",
      "argv": ["docs/comet/changes/webui-cross-channel-change/scratch/verify_impl.py"],
      "cwdRef": ".",
      "timeoutMs": 300000,
      "repeatable": true
    }
  ]
}
